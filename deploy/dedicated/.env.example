# TeamBot Dedicated — kopieer naar .env en vul in:  cp .env.example .env && chmod 600 .env
# Bewaar .env veilig: er staat je hoofdsleutel in. Zet hem niet in git en niet bij je back-ups.

# Domeinnaam van je TeamBot (DNS A/AAAA-record naar deze server) en het volledige adres.
TEAMBOT_DOMAIN=teambot.jouwbedrijf.nl
TEAMBOT_PUBLIC_URL=https://teambot.jouwbedrijf.nl

# E-mailadres voor Let's Encrypt (meldingen over je TLS-certificaat).
ACME_EMAIL=it@jouwbedrijf.nl

# Hoofdsleutel: versleutelt de API-sleutels die je in TeamBot opslaat. Maak hem één keer:
#   openssl rand -base64 32
# en verander hem daarna nooit. Kwijt = opgeslagen sleutels onleesbaar. Bewaar een kopie in je wachtwoordkluis.
# TeamBot Cloud krijgt deze sleutel nooit.
TEAMBOT_MASTER_KEY=

# Van TeamBot Cloud gekregen (eenmalig getoond). Nodig om het eerste eigenaar-account aan te maken:
#   https://<TEAMBOT_DOMAIN>/?setup=<TEAMBOT_SETUP_TOKEN>
TEAMBOT_SETUP_TOKEN=
# Aantal mensen volgens je abonnement.
TEAMBOT_MAX_USERS=100

# TeamBot-image: van ons gekregen, of zelf gebouwd uit de broncode (docker build -t teambot:0.1.0 .).
# Gebruik altijd een vaste versie, geen "latest": dan kies je zelf wanneer je bijwerkt.
TEAMBOT_IMAGE=teambot:0.1.0
TEAMBOT_MEMORY=4g

# Back-ups (backup.sh / restore-test.sh)
BACKUP_DIR=/var/backups/teambot
KEEP_DAYS=14
